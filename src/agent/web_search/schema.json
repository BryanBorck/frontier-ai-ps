{
  "name": "web_search",
  "description": "Searches the web for up-to-date information using Exa AI.",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "The search query to execute."
      },
      "num_results": {
        "type": "integer",
        "description": "Maximum number of results to return.",
        "default": 5
      },
      "include_text": {
        "type": "boolean",
        "description": "Whether to include text content from the pages.",
        "default": true
      },
      "include_highlights": {
        "type": "boolean",
        "description": "Whether to include highlighted snippets.",
        "default": false
      }
    },
    "required": ["query"]
  }
}

