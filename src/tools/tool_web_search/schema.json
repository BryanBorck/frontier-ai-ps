{
  "tool_name": "tool_web_search",
  "description": "Search the web using Exa AI for high-quality, AI-powered search results. Returns relevant web pages with titles, URLs, and content snippets.",
  "input_schema": {
    "query": {
      "type": "string",
      "description": "The search query to execute"
    },
    "num_results": {
      "type": "integer",
      "default": 10,
      "description": "Maximum number of results to return (default: 10)"
    },
    "include_text": {
      "type": "boolean",
      "default": true,
      "description": "Whether to include text content from the pages (default: true)"
    },
    "include_highlights": {
      "type": "boolean",
      "default": false,
      "description": "Whether to include highlighted snippets (default: false)"
    },
    "use_autoprompt": {
      "type": "boolean",
      "default": true,
      "description": "Whether to use Exa's autoprompt feature for query optimization (default: true)"
    }
  },
  "output_schema": {
    "type": "array",
    "description": "List of search results from Exa",
    "items": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Page title"
        },
        "url": {
          "type": "string",
          "description": "Page URL"
        },
        "published_date": {
          "type": "string",
          "description": "Publication date if available"
        },
        "author": {
          "type": "string",
          "description": "Author if available"
        },
        "score": {
          "type": "number",
          "description": "Relevance score from Exa"
        },
        "text": {
          "type": "string",
          "description": "Page text content (if include_text=true)"
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Highlighted snippets (if include_highlights=true)"
        }
      },
      "required": ["title", "url", "score"]
    }
  }
}
